# ============================================================
# WhatsApp Bot — Environment Configuration
# Copy this file to ".env" and fill in real values before start.
# NEVER commit your real .env file.
# ============================================================

# --- Bot identity -----------------------------------------------------------
BOT_NAME=Spyro Bot
BOT_PREFIX=.
BOT_LOCALE=en

# --- Web UI -----------------------------------------------------------------
# Port for the web control panel (Koyeb/Railway/Render auto-set PORT)
PORT=3000
HOST=0.0.0.0

# --- Database (Neon PostgreSQL) -------------------------------------------
# Set DATABASE_URL to use PostgreSQL instead of SQLite.
# Get yours from https://neon.tech (free tier)
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# --- Owner ------------------------------------------------------------------
# Must be a full JID: <phonenumber>@s.whatsapp.net  (e.g. 254700000000@s.whatsapp.net)
OWNER_JID=

# --- Session / storage ------------------------------------------------------
SESSION_DIR=./auth_info
DATABASE_PATH=./data/bot.sqlite

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# true = pretty colored logs (dev); false = JSON logs (production)
LOG_PRETTY=true

# --- Media limits -----------------------------------------------------------
MAX_MEDIA_MB=20
# Optional path to ffmpeg binary if not on PATH
FFMPEG_PATH=
# Optional path to ffprobe binary if not on PATH
FFPROBE_PATH=

# --- Behavior ---------------------------------------------------------------
# Cooldown (seconds) applied per-user for ordinary commands
COMMAND_COOLDOWN=3
# Max warnings before auto-action (0 = disabled)
DEFAULT_WARN_LIMIT=3
# Maintenance mode (true = only owner can use the bot)
MAINTENANCE_MODE=false

# --- Optional external services (bot runs fine without these) --------------
ENABLE_AI=false
# Any OpenAI-compatible endpoint
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional URL shortener
SHORTENER_API_KEY=

# Optional weather (openweathermap.org)
OPENWEATHER_API_KEY=

# Optional currency (open.er-api.com is free, key optional)
CURRENCY_API_KEY=

# Optional dictionary (dictionaryapi.dev is free, key optional)
DICTIONARY_API_KEY=

# Optional QR code generation (api.qrserver.com is free)
QR_API_BASE=https://api.qrserver.com/v1

# Optional joke / meme providers
JOKE_API_BASE=https://v2.jokeapi.dev
MEME_API_BASE=https://meme-api.com/gimme

# Donation / support strings
DONATE_INFO=Support the bot: send coffee money to owner.
SUPPORT_INFO=Join support: https://github.com/WhiskeySockets/Baileys
