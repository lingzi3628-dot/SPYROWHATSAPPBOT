{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "Modular WhatsApp bot built on @whiskeysockets/baileys 7.0.0-rc14",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=256 src/index.js",
    "start:web": "PORT=3000 node --max-old-space-size=256 src/index.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "test": "node scripts/run-tests.js",
    "test:raw": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "lint": "eslint .",
    "db:init": "node src/database.js",
    "pair": "node scripts/pair-phone.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fluent-ffmpeg": "^2.1.3",
    "nanoid": "^5.0.9",
    "node-cache": "^5.1.2",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "eslint": "^9.20.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "bcrypt@6.0.0": true
  }
}
